@@ -0,0 +1,91 @@
+import * as React from "react";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { invoke } from "@tauri-apps/api/core";
+import { Loader2, RefreshCw } from "lucide-react";
+import type { Session } from "@/lib/types";
+
+type TmuxWindow = { id: string; index: number; name: string; active: boolean };
+
+type Props = {
+  hostId: string;
+  session: Session;
+  enabled: boolean;
+  onSelected: () => void;
+};
+
+export function WindowTabs({ hostId, session, enabled, onSelected }: Props) {
+  const queryClient = useQueryClient();
+  const stripRef = React.useRef<HTMLDivElement>(null);
+  const aliveRef = React.useRef(true);
+  React.useEffect(() => {
+    aliveRef.current = true;
+    return () => { aliveRef.current = false; };
+  }, []);
+  const queryKey = ["tmux-windows", hostId, session.socket, session.name];
+  const args = { hostId, socket: session.socket, sessionName: session.name };
+  const windows = useQuery({
+    queryKey,
+    queryFn: () => invoke<TmuxWindow[]>("list_windows", args),
+    enabled,
+    refetchInterval: 10_000,
+    refetchIntervalInBackground: false,
+    retry: false,
+  });
+  const selection = useMutation({
+    mutationFn: (windowId: string) => invoke<void>("select_window", { ...args, windowId }),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey });
+      if (aliveRef.current) onSelected();
+    },
+  });
+  const activeId = windows.data?.find((window) => window.active)?.id;
+  React.useEffect(() => {
+    stripRef.current?.querySelector('[aria-pressed="true"]')?.scrollIntoView({
+      block: "nearest", inline: "nearest",
+    });
+  }, [activeId]);
+
+  return (
+    <section aria-label="tmux window 切換" className="border-b border-border bg-background">
+      <div className="flex min-w-0 items-center gap-2 px-3 py-2">
+        <span className="shrink-0 text-xs text-muted-foreground">Windows</span>
+        <div ref={stripRef} role="group" aria-label="此專案的 tmux windows"
+          aria-busy={windows.isFetching || selection.isPending}
+          className="flex min-w-0 flex-1 gap-1 overflow-x-auto">
+          {!enabled || windows.isPending ? (
+            <span role="status" className="px-2 py-1 text-sm text-muted-foreground">連線後載入分頁…</span>
+          ) : windows.data?.length === 0 ? (
+            <span role="status" className="px-2 py-1 text-sm text-muted-foreground">沒有可用的 window</span>
+          ) : windows.data?.map((window) => (
+            <button key={window.id} type="button" aria-pressed={window.active}
+              disabled={!enabled || selection.isPending || windows.isError}
+              title={window.name}
+              onClick={() => selection.mutate(window.id)}
+              className={`flex max-w-64 shrink-0 items-center gap-1.5 rounded px-3 py-1.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-wait disabled:opacity-50 ${window.active ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:bg-muted hover:text-foreground"}`}>
+              {selection.isPending && selection.variables === window.id && (
+                <Loader2 aria-hidden="true" className="h-3.5 w-3.5 shrink-0 animate-spin" />
+              )}
+              <span className="shrink-0 tabular-nums">{window.index}</span>
+              <span className="truncate">{window.name}</span>
+            </button>
+          ))}
+        </div>
+        <button type="button" aria-label="更新 window 分頁" title="更新 window 分頁"
+          disabled={!enabled || windows.isFetching || selection.isPending}
+          onClick={() => { selection.reset(); void windows.refetch(); }}
+          className="shrink-0 rounded p-2 text-muted-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50">
+          <RefreshCw aria-hidden="true" className={`h-4 w-4 ${windows.isFetching ? "animate-spin" : ""}`} />
+        </button>
+      </div>
+      {(windows.isError || selection.isError) && (
+        <div role="alert" className="flex items-center justify-between gap-3 px-4 pb-2 text-sm text-destructive">
+          <span>無法{selection.isError ? "切換" : "載入"} window，請重新整理後再試。</span>
+          <button type="button" onClick={() => { selection.reset(); void windows.refetch(); }}
+            className="shrink-0 rounded px-2 py-1 underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
+            重新整理
+          </button>
+        </div>
+      )}
+    </section>
+  );
+}
