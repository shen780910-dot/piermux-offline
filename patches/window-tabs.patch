+
+async fn send(writer: &mut (impl AsyncWriteExt + Unpin), message: &Value) -> Result<()> {
+    let mut body = serde_json::to_vec(message)?;
+    body.push(b'\n');
+    writer.write_all(&body).await?;
+    Ok(())
+}
+
+async fn response(reader: &mut (impl AsyncBufReadExt + Unpin)) -> Result<Value> {
+    let mut line = String::new();
+    if reader.read_line(&mut line).await? == 0 { bail!("本機連線已關閉"); }
+    let value: Value = serde_json::from_str(&line)?;
+    if value.get("ok") == Some(&Value::Bool(false)) {
+        bail!("{}", value["error"].as_str().unwrap_or("本機操作失敗"));
+    }
+    Ok(value)
+}
+
+async fn rpc(path: &str, message: Value) -> Result<Value> {
+    tokio::time::timeout(std::time::Duration::from_secs(130), async {
+        let mut stream = UnixStream::connect(path).await.context("本機 bridge 無法連線，請使用新版 start-piermux.sh 啟動")?;
+        send(&mut stream, &message).await?;
+        response(&mut BufReader::new(stream)).await
+    }).await.map_err(|_| anyhow!("本機操作逾時"))?
+}
+
+impl Session {
+    pub async fn local() -> Result<Self> {
+        let path = std::env::var("PIERMUX_LOCAL_SOCKET")
+            .context("找不到本機連線，請使用新版 start-piermux.sh 啟動")?;
+        rpc(&path, json!({"op": "ping"})).await?;
+        Ok(Self::Local(path))
+    }
+    pub async fn exec(&self, cmd: &str) -> Result<String> {
+        match self {
+            Self::Remote(session) => session.exec(cmd).await,
+            Self::Local(path) => Ok(rpc(path, json!({"op":"exec", "cmd":cmd})).await?["stdout"].as_str().unwrap_or("").to_string()),
+        }
+    }
+    pub async fn upload(&self, target: &str, data: &[u8]) -> Result<()> {
+        match self {
+            Self::Remote(session) => session.upload(target, data).await,
+            Self::Local(path) => {
+                tokio::time::timeout(std::time::Duration::from_secs(300), async {
+                    let mut stream = UnixStream::connect(path).await?;
+                    send(&mut stream, &json!({"op":"upload", "cmd":format!("cat > {target}"), "size":data.len()})).await?;
+                    let (read, mut write) = stream.into_split();
+                    let mut reader = BufReader::new(read);
+                    response(&mut reader).await?;
+                    if let Err(error) = write.write_all(data).await {
+                        return match response(&mut reader).await {
+                            Err(remote) => Err(remote),
+                            Ok(_) => Err(error.into()),
+                        };
+                    }
+                    write.shutdown().await?;
+                    response(&mut reader).await?;
+                    Ok(())
+                }).await.map_err(|_| anyhow!("本機上傳逾時"))?
+            }
+        }
+    }
+    pub async fn open_pty(&self, cols: u32, rows: u32) -> Result<PtyChannel> {
+        match self {
+            Self::Remote(session) => Ok(PtyChannel::Remote(session.open_pty(cols, rows).await?)),
+            Self::Local(path) => Ok(PtyChannel::Local { path:path.clone(), cols, rows, parts:None }),
+        }
+    }
+}
+
+pub enum PtyChannel {
+    Remote(ssh::PtyChannel),
+    Local { path:String, cols:u32, rows:u32, parts:Option<(PtyRead, PtyWrite)> },
+}
+
+impl PtyChannel {
+    async fn start_local(&mut self, command: Option<&str>) -> Result<()> {
+        let Self::Local { path, cols, rows, parts } = self else { unreachable!() };
+        let mut stream = UnixStream::connect(path.as_str()).await?;
+        let mut message = json!({"op":"pty", "cols":cols, "rows":rows});
+        if let Some(cmd) = command { message["cmd"] = json!(cmd); }
+        else { message["shell"] = json!(true); }
+        send(&mut stream, &message).await?;
+        let (read, write) = stream.into_split();
+        let mut reader = BufReader::new(read);
+        tokio::time::timeout(std::time::Duration::from_secs(15), response(&mut reader)).await??;
+        *parts = Some((PtyRead::Local(reader), PtyWrite::Local(Mutex::new(write))));
+        Ok(())
+    }
+    pub async fn exec(&mut self, cmd: &str) -> Result<()> {
+        match self {
+            Self::Remote(channel) => channel.exec(cmd).await,
+            Self::Local { .. } => self.start_local(Some(cmd)).await,
+        }
+    }
+    pub async fn shell(&mut self) -> Result<()> {
+        match self {
+            Self::Remote(channel) => channel.shell().await,
+            Self::Local { .. } => self.start_local(None).await,
+        }
+    }
+    pub fn into_parts(self) -> (PtyRead, PtyWrite) {
+        match self {
+            Self::Remote(channel) => {
+                let (read, write) = channel.into_parts();
+                (PtyRead::Remote(read), PtyWrite::Remote(write))
+            }
+            Self::Local { parts, .. } => parts.expect("PTY must be started before splitting"),
+        }
+    }
+}
+
+pub enum PtyMsg {
+    Data { data:Vec<u8> },
+    ExtendedData { data:Vec<u8> },
+    Eof,
+    Close,
+    ExitStatus {},
+    Other,
+}
+pub enum PtyRead {
+    Remote(ssh::PtyRead),
+    Local(BufReader<OwnedReadHalf>),
+}
+impl PtyRead {
+    pub async fn wait(&mut self) -> Option<PtyMsg> {
+        match self {
+            Self::Remote(read) => read.wait().await.map(|message| match message {
+                ssh::PtyMsg::Data { data } => PtyMsg::Data { data:data.to_vec() },
+                ssh::PtyMsg::ExtendedData { data, .. } => PtyMsg::ExtendedData { data:data.to_vec() },
+                ssh::PtyMsg::Eof => PtyMsg::Eof,
+                ssh::PtyMsg::Close => PtyMsg::Close,
+                ssh::PtyMsg::ExitStatus { .. } => PtyMsg::ExitStatus {},
+                _ => PtyMsg::Other,
+            }),
+            Self::Local(read) => {
+                let value = match response(read).await {
+                    Ok(value) => value,
+                    Err(error) => { eprintln!("[local PTY] {error}"); return None; }
+                };
+                match value["event"].as_str() {
+                    Some("data") => serde_json::from_value(value["data"].clone()).ok().map(|data| PtyMsg::Data { data }),
+                    Some("eof") => Some(PtyMsg::Eof),
+                    _ => None,
+                }
+            }
+        }
+    }
+}
+pub enum PtyWrite {
+    Remote(ssh::PtyWrite),
+    Local(Mutex<OwnedWriteHalf>),
+}
+impl PtyWrite {
+    pub async fn data_bytes(&self, data: Vec<u8>) -> Result<()> {
+        match self {
+            Self::Remote(write) => Ok(write.data_bytes(data).await?),
+            Self::Local(write) => send(&mut *write.lock().await, &json!({"op":"input", "data":data})).await,
+        }
+    }
+    pub async fn window_change(&self, cols:u32, rows:u32, x:u32, y:u32) -> Result<()> {
+        match self {
+            Self::Remote(write) => Ok(write.window_change(cols, rows, x, y).await?),
+            Self::Local(write) => send(&mut *write.lock().await, &json!({"op":"resize", "cols":cols, "rows":rows})).await,
+        }
+    }
+    pub async fn close(&self) -> Result<()> {
+        match self {
+            Self::Remote(write) => Ok(write.close().await?),
+            Self::Local(write) => {
+                let mut write = write.lock().await;
+                send(&mut *write, &json!({"op":"close"})).await?;
+                write.shutdown().await?;
+                Ok(())
+            }
+        }
+    }
+}
