+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_nonzero_indexes_unicode_and_delimiters_in_names() {
+        let windows = parse_windows("@9|3|0|agent-1\n@10|7|1|專案 A | review\n").unwrap();
+        assert_eq!(windows.len(), 2);
+        assert_eq!(windows[1], TmuxWindow {
+            id: "@10".into(), index: 7, name: "專案 A | review".into(), active: true,
+        });
+    }
+
+    #[test]
+    fn empty_output_is_an_empty_list() {
+        assert!(parse_windows("\n").unwrap().is_empty());
+    }
+
+    #[test]
+    fn rejects_invalid_or_injectable_window_ids() {
+        for id in ["", "@", "1", "@-1", "@1;exit", "@１", "@1:2"] {
+            assert!(!valid_window_id(id), "{id}");
+        }
+        assert!(valid_window_id("@0"));
+        assert!(valid_window_id("@123"));
+    }
+
+    #[test]
+    fn rejects_malformed_records_instead_of_switching_to_another_target() {
+        for line in ["@1|name", "@1|oops|0|name", "@1|0|2|name", "oops|0|1|name"] {
+            assert!(parse_windows(line).is_err(), "{line}");
+        }
+    }
+
+    #[test]
+    fn quotes_session_names_as_a_single_shell_argument() {
+        assert_eq!(quote("project's work"), "'project'\\''s work'");
+    }
+
+    #[test]
+    fn exact_targets_do_not_fall_back_to_another_project() {
+        assert_eq!(exact_target("project-a", None), "=project-a:");
+        assert_eq!(exact_target("project-a", Some("@9")), "=project-a:@9");
+    }
+}
