+use serde::Serialize;
+use sqlx::sqlite::SqlitePool;
+use tauri::State;
+
+use crate::{hosts, sessions};
+
+#[derive(Debug, Serialize, PartialEq)]
+pub struct TmuxWindow {
+    id: String,
+    index: u32,
+    name: String,
+    active: bool,
+}
+
+fn valid_window_id(value: &str) -> bool {
+    value.strip_prefix('@').is_some_and(|digits| {
+        !digits.is_empty() && digits.bytes().all(|b| b.is_ascii_digit())
+    })
+}
+
+fn parse_windows(output: &str) -> Result<Vec<TmuxWindow>, String> {
+    output.lines().filter(|line| !line.is_empty()).map(|line| {
+        let columns: Vec<_> = line.splitn(4, '|').collect();
+        if columns.len() != 4 || !valid_window_id(columns[0]) {
+            return Err(format!("Invalid tmux window record: {line}"));
+        }
+        let index = columns[1].parse().map_err(|_| "Invalid window index".to_string())?;
+        let active = match columns[2] {
+            "1" => true,
+            "0" => false,
+            _ => return Err("Invalid window active flag".into()),
+        };
+        Ok(TmuxWindow { id: columns[0].into(), index, name: columns[3].into(), active })
+    }).collect()
+}
+
+fn quote(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+fn exact_target(session_name: &str, window_id: Option<&str>) -> String {
+    format!("={session_name}:{}", window_id.unwrap_or(""))
+}
+
+#[tauri::command]
+pub async fn list_windows(
+    pool: State<'_, SqlitePool>,
+    host_id: String,
+    socket: String,
+    session_name: String,
+) -> Result<Vec<TmuxWindow>, String> {
+    let host = hosts::fetch_one(pool.inner(), &host_id).await.map_err(|e| e.to_string())?;
+    let command = format!(
+        "{} list-windows -t {} -F '#{{window_id}}|#{{window_index}}|#{{window_active}}|#{{window_name}}'",
+        sessions::tmux_cmd(&host, &socket), quote(&exact_target(&session_name, None))
+    );
+    let output = sessions::run_on_host(pool.inner(), &host, &command).await.map_err(|e| e.to_string())?;
+    parse_windows(&output)
+}
+
+#[tauri::command]
+pub async fn select_window(
+    pool: State<'_, SqlitePool>,
+    host_id: String,
+    socket: String,
+    session_name: String,
+    window_id: String,
+) -> Result<(), String> {
+    if !valid_window_id(&window_id) {
+        return Err("Invalid tmux window ID".into());
+    }
+    let host = hosts::fetch_one(pool.inner(), &host_id).await.map_err(|e| e.to_string())?;
+    let target = exact_target(&session_name, Some(&window_id));
+    let command = format!("{} select-window -t {}", sessions::tmux_cmd(&host, &socket), quote(&target));
+    sessions::run_on_host(pool.inner(), &host, &command).await.map_err(|e| e.to_string())?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_nonzero_indexes_unicode_and_delimiters_in_names() {
+        let windows = parse_windows("@9|3|0|agent-1\n@10|7|1|專案 A | review\n").unwrap();
+        assert_eq!(windows.len(), 2);
+        assert_eq!(windows[1], TmuxWindow {
+            id: "@10".into(), index: 7, name: "專案 A | review".into(), active: true,
+        });
+    }
+
+    #[test]
+    fn empty_output_is_an_empty_list() {
+        assert!(parse_windows("\n").unwrap().is_empty());
+    }
+
+    #[test]
+    fn rejects_invalid_or_injectable_window_ids() {
+        for id in ["", "@", "1", "@-1", "@1;exit", "@１", "@1:2"] {
+            assert!(!valid_window_id(id), "{id}");
+        }
+        assert!(valid_window_id("@0"));
+        assert!(valid_window_id("@123"));
+    }
+
+    #[test]
+    fn rejects_malformed_records_instead_of_switching_to_another_target() {
+        for line in ["@1|name", "@1|oops|0|name", "@1|0|2|name", "oops|0|1|name"] {
+            assert!(parse_windows(line).is_err(), "{line}");
+        }
+    }
+
+    #[test]
+    fn quotes_session_names_as_a_single_shell_argument() {
+        assert_eq!(quote("project's work"), "'project'\\''s work'");
+    }
+
+    #[test]
+    fn exact_targets_do_not_fall_back_to_another_project() {
+        assert_eq!(exact_target("project-a", None), "=project-a:");
+        assert_eq!(exact_target("project-a", Some("@9")), "=project-a:@9");
+    }
+}
